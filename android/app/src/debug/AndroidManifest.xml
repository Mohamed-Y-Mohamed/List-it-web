<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug-only manifest overlay. Merged into debug builds and never into release,
  so the shipped app keeps Android's default "no cleartext" policy.

  Points the app at the debug network security config, which allows plain HTTP to
  the host machine for local end-to-end testing.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:networkSecurityConfig="@xml/network_security_config"
        tools:replace="android:networkSecurityConfig" />

</manifest>
