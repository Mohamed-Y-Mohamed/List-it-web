<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ replacement for allowBackup/fullBackupContent.

  Both cloud backup and device-to-device transfer are refused outright: the
  WebView's localStorage holds the signed-in Supabase session, and restoring it
  onto another device would hand that device a live session. The user's lists,
  tasks and notes all live in the account and return on sign-in, so nothing of
  value is lost by excluding everything.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="file" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="file" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
