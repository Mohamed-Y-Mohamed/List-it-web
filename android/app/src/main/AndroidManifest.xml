<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!--
      allowBackup is off deliberately. The signed-in session is held in the
      WebView's localStorage, and Android's auto-backup would copy it to the
      user's Drive and restore it onto a different device — handing that device a
      live session. Everything here is already synced to the account and comes
      back on sign-in, so there is nothing worth backing up and a real reason not
      to.
    -->
    <application
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Android 13+ requires an explicit grant to post notifications. Asked for
         lazily, only once there is actually a reminder to schedule. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      The local-notifications plugin declares the exact-alarm permissions by
      default. Both are dropped here.

      SCHEDULE_EXACT_ALARM sends the user into system Settings to grant "Alarms &
      reminders", and Play restricts it to alarm clocks and calendars — a to-do
      reminder is unlikely to qualify and shipping it invites a policy rejection.
      A "this is due today" nudge does not need to land on the second, so the
      reminder is scheduled inexactly instead and neither permission is needed.
    -->
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.USE_EXACT_ALARM"
        tools:node="remove" />
</manifest>
