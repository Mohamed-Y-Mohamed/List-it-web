# Copy to android/keystore.properties and fill in. That file is gitignored —
# never commit it, and never commit the .jks itself.
#
# Create the upload key once:
#
#   keytool -genkeypair -v \
#     -keystore listit-upload.jks \
#     -alias listit-upload \
#     -keyalg RSA -keysize 2048 -validity 10000
#
# Keep the .jks and these passwords backed up somewhere you will still have in a
# year. With Play App Signing an upload key can be reset through Google support if
# it is lost, but that is a delay you do not want mid-release.
#
# storeFile is resolved relative to the android/ directory.

storeFile=listit-upload.jks
storePassword=
keyAlias=listit-upload
keyPassword=
