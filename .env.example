# Supabase project
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public origin of the deployed web app. Used for verification and
# password-reset links, so it must be reachable from a mail client.
NEXT_PUBLIC_SITE_URL=

# Origin the native Android build calls for /api/*. The app inside the WebView is
# served from https://localhost and has no API of its own, so this must point at
# the deployed web app. Required for `npm run build:native`.
NEXT_PUBLIC_API_BASE_URL=

# Optional Google Analytics measurement id (G-XXXXXXXXXX)
NEXT_PUBLIC_GA_ID=
