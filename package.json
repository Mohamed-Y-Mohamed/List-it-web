{
  "name": "List-It",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "build:native": "node scripts/build-native.mjs",
    "android:sync": "npm run build:native && cap sync android",
    "android:open": "cap open android",
    "android:run": "npm run android:sync && cap run android",
    "android:local": "cross-env CAP_LOCAL_API=1 NEXT_PUBLIC_API_BASE_URL=http://10.0.2.2:3000 npm run android:sync",
    "start": "next start",
    "lint": "next lint",
    "format": "npx prettier . --write",
    "type-check": "npx tsc --noEmit",
    "audit": "npm audit --omit=dev",
    "postbuild": "next-sitemap",
    "test": "jest",
    "test:watch": "jest --watch",
    "prepare": "husky install",
    "pre-push": ".husky/pre-push",
    "android:release": "npm run build:native && cap sync android && cd android && gradlew.bat bundleRelease"
  },
  "lint-staged": {
    "*.{js,ts,tsx}": [
      "npm test -- --bail --findRelatedTests"
    ]
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@supabase/auth-helpers-nextjs": "^0.10.0",
    "@supabase/supabase-js": "^2.49.4",
    "crypto-js": "^4.2.0",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.12.2",
    "lucide-react": "^0.487.0",
    "next": "^15.5.9",
    "next-sitemap": "^4.2.3",
    "pinst": "^3.0.0",
    "postcss": "^8.5.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-icons": "^5.5.0",
    "recharts": "^2.15.3",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@eslint/eslintrc": "^3",
    "@next/bundle-analyzer": "^15.2.3",
    "@tailwindcss/postcss": "^4.0.14",
    "@types/crypto-js": "^4.2.2",
    "@types/jest": "^29.5.14",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^10.1.0",
    "daisyui": "^5.0.0",
    "eslint": "^9",
    "eslint-config-next": "15.2.1",
    "eslint-config-prettier": "^10.1.1",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.3.0",
    "lint-staged": "^15.5.1",
    "prettier": "^3.5.3",
    "tailwindcss": "^4.0.14",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "typescript": "^5"
  },
  "packageManager": "npm@11.2.0",
  "engines": {
    "node": "22.14.0"
  }
}
